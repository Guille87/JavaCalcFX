<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.guillermoamadodiaz</groupId>
    <artifactId>JavaCalcFX</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.10</javafx.version>
        <junit.version>6.1.3</junit.version>
        <testfx.version>4.0.18</testfx.version>
        <!-- Monocle se queda en la 17.x: es compatible con JavaFX 21 en runtime y
             su bytecode corre en JDK 17 (la 21.x exige un runtime 21+ y rompería
             el job de JDK 17 de la CI). -->
        <monocle.version>17.0.10</monocle.version>
        <!-- Los tests de UI corren sin pantalla (Monocle). El perfil «headed» lo desactiva. -->
        <headless.args>-Djava.awt.headless=true -Dtestfx.robot=glass -Dtestfx.headless=true -Dglass.platform=Monocle -Dmonocle.platform=Headless -Dprism.order=sw -Dprism.text=t2k</headless.args>
        <!-- Lo rellena jacoco:prepare-agent; el valor por defecto vacío permite `-Pheaded` sin JaCoCo. -->
        <jacoco.argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>${monocle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!-- Formato: `mvn spotless:apply` arregla, `mvn spotless:check` verifica (lo hace la CI). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.2</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.97.0</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- TestFX no funciona bien en el module-path: los tests van por classpath. -->
                    <useModulePath>false</useModulePath>
                    <!-- @{jacoco.argLine} lo inyecta jacoco:prepare-agent en tiempo de ejecución. -->
                    <argLine>@{jacoco.argLine} ${headless.args}</argLine>
                </configuration>
            </plugin>

            <!-- Cobertura: `mvn test` genera target/site/jacoco/ (HTML + jacoco.xml). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <propertyName>jacoco.argLine</propertyName>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.guillermoamadodiaz.javacalcfx/io.guillermoamadodiaz.javacalcfx.SelectorDeOpciones</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <!-- mvn clean javafx:run -->
                        <id>default-cli</id>
                    </execution>
                    <execution>
                        <!-- mvn clean javafx:run@debug  (attach on localhost:8000) -->
                        <id>debug</id>
                        <configuration>
                            <options>
                                <option>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=localhost:8000</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pheaded  → ejecuta los tests de UI con ventana visible -->
        <profile>
            <id>headed</id>
            <properties>
                <headless.args></headless.args>
            </properties>
        </profile>
    </profiles>
</project>
