<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.guillermoamadodiaz</groupId>
    <artifactId>JavaCalcFX</artifactId>
    <version>0.1.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.12</javafx.version>
        <junit.version>6.1.3</junit.version>
        <testfx.version>4.0.18</testfx.version>
        <!-- Monocle se queda en la 17.x: es compatible con JavaFX 21 en runtime y
             su bytecode corre en JDK 17 (la 21.x exige un runtime 21+ y rompería
             el job de JDK 17 de la CI). -->
        <monocle.version>17.0.10</monocle.version>
        <!-- Los tests de UI corren sin pantalla (Monocle). El perfil «headed» lo desactiva. -->
        <headless.args>-Djava.awt.headless=true -Dtestfx.robot=glass -Dtestfx.headless=true -Dglass.platform=Monocle -Dmonocle.platform=Headless -Dprism.order=sw -Dprism.text=t2k</headless.args>
        <!-- Lo rellena jacoco:prepare-agent; el valor por defecto vacío permite `-Pheaded` sin JaCoCo. -->
        <jacoco.argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>${monocle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!-- Formato: `mvn spotless:apply` arregla, `mvn spotless:check` verifica (lo hace la CI). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.2</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.97.0</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
            </plugin>

            <!-- Análisis estático: `mvn compile spotbugs:check` (lo hace la CI). Solo el
                 código de producción; ver spotbugs-exclude.xml para los descartes. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.6.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- TestFX no funciona bien en el module-path: los tests van por classpath. -->
                    <useModulePath>false</useModulePath>
                    <!-- @{jacoco.argLine} lo inyecta jacoco:prepare-agent en tiempo de ejecución. -->
                    <argLine>@{jacoco.argLine} ${headless.args}</argLine>
                </configuration>
            </plugin>

            <!-- Cobertura: `mvn test` genera target/site/jacoco/ (HTML + jacoco.xml). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <propertyName>jacoco.argLine</propertyName>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.guillermoamadodiaz.javacalcfx/io.guillermoamadodiaz.javacalcfx.CalculatorApp</mainClass>
                    <!-- `mvn javafx:jlink` genera target/JavaCalcFX: runtime autocontenido + bin/JavaCalcFX. -->
                    <launcher>JavaCalcFX</launcher>
                    <jlinkImageName>JavaCalcFX</jlinkImageName>
                    <jlinkZipName>JavaCalcFX</jlinkZipName>
                    <stripDebug>true</stripDebug>
                    <noManPages>true</noManPages>
                    <noHeaderFiles>true</noHeaderFiles>
                </configuration>
                <executions>
                    <execution>
                        <!-- mvn clean javafx:run -->
                        <id>default-cli</id>
                    </execution>
                    <execution>
                        <!-- mvn clean javafx:run@debug  (attach on localhost:8000) -->
                        <id>debug</id>
                        <configuration>
                            <options>
                                <option>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=localhost:8000</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pheaded  → ejecuta los tests de UI con ventana visible -->
        <profile>
            <id>headed</id>
            <properties>
                <headless.args></headless.args>
            </properties>
        </profile>

        <!--
          mvn -Pdist clean javafx:jlink package  →  app-image portable de Windows
          en target/dist/JavaCalcFX (carpeta con JavaCalcFX.exe, sin instalar nada).
            · javafx:jlink monta el runtime autocontenido en target/JavaCalcFX
            · jpackage lo envuelve en la app-image
          Para el instalador .msi:  mvn -Pdist,installer clean javafx:jlink package
          (necesita WiX 3.x en PATH; los runners windows-latest de GitHub lo traen).
        -->
        <profile>
            <id>dist</id>
            <properties>
                <jpackage.type>APP_IMAGE</jpackage.type>
                <app.version>${project.version}</app.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>empaquetar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>${jpackage.type}</type>
                                    <name>JavaCalcFX</name>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>Guillermo Amado Diaz</vendor>
                                    <copyright>Guillermo Amado Diaz - MIT</copyright>
                                    <runtimeImage>${project.build.directory}/JavaCalcFX</runtimeImage>
                                    <module>
                                        io.guillermoamadodiaz.javacalcfx/io.guillermoamadodiaz.javacalcfx.CalculatorApp</module>
                                    <icon>src/main/resources/io/guillermoamadodiaz/javacalcfx/icons/icon.ico</icon>
                                    <destination>${project.build.directory}/dist</destination>
                                    <javaOptions>
                                        <option>-Dfile.encoding=UTF-8</option>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Añade a -Pdist las opciones del instalador .msi (menú Inicio, acceso
             directo, selector de carpeta). Se activa junto con dist. -->
        <profile>
            <id>installer</id>
            <properties>
                <jpackage.type>MSI</jpackage.type>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>empaquetar</id>
                                <configuration>
                                    <winMenu>true</winMenu>
                                    <winMenuGroup>JavaCalcFX</winMenuGroup>
                                    <winShortcut>true</winShortcut>
                                    <winShortcutPrompt>true</winShortcutPrompt>
                                    <winDirChooser>true</winDirChooser>
                                    <winPerUserInstall>true</winPerUserInstall>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
